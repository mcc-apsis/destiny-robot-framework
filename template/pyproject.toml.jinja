[build-system]
build-backend = "hatchling.build"
requires = ["hatchling"]

[project]
name = "{{ robot_name }}"
version = "0.1.0"
requires-python = ">=3.13"

dependencies = [
    "destiny-robot-framework",
    "pydantic-settings",
]

[tool.hatch.metadata]
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/{{ robot_name }}"]

[tool.uv.sources]
destiny-robot-framework = { git = "https://github.com/mcc-apsis/destiny-robot-framework.git" }